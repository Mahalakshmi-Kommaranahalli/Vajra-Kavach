# ==============================================================================
# Vajra-Kavach Environment Configuration
# 100% Offline, Air-Gapped Clinical Privacy Firewall
# ==============================================================================

# Air-gap toggle: Set to 'true' to completely block all outbound network sockets
OFFLINE_MODE=true

# Secret cryptographic key for HMAC pseudonyms and date shifting (NEVER commit real secrets)
RAKSHA_SECRET=practice

# Path to the active privacy policy
RAKSHAK_POLICY=./config/policy.yaml

# Local persistence adapter (sqlite / json / memory)
DATABASE_ADAPTER=sqlite
SQLITE_DB_PATH=./data/vajra_records.db

# Local assets directory (gazetteers, dictionaries, formulary)
ASSETS_DIR=./assets

# Local pip wheelhouse directory for offline installs
WHEELHOUSE_DIR=./wheelhouse
